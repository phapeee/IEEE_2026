<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="mini_ros2_control" params="robot_namespace:=''">
    <xacro:property name="topic_prefix" value="${'/' + robot_namespace if robot_namespace else ''}"/>
    <ros2_control name="mini_system" type="system">
      <hardware>
        <plugin>i2c_velocity_hardware/I2cVelocityHardware</plugin>

        <param name="i2c_address">0x10</param>
        <param name="command_register">0x01</param>
        <param name="state_register">0x10</param>
        <param name="centi_rps_scale">100.0</param>
        <param name="max_rps">2.3</param>
        <param name="expected_joints">4</param>
        <param name="i2c_service">${topic_prefix}/i2c_manager/transfer</param>
        <param name="node_namespace">${topic_prefix}</param>
        <param name="node_name">i2c_velocity_hardware</param>
        <param name="service_timeout_sec">0.05</param>
        <param name="log_measured_velocities">true</param>
        <param name="log_measured_velocities_ms">1000</param>
      </hardware>
      <joint name="Front_Left_Wheel">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <param name="i2c_index">2</param>
      </joint>
      <joint name="Front_Right_Wheel">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <param name="i2c_index">3</param>
        <param name="velocity_sign">-1</param>
      </joint>
      <joint name="Rear_Left_Wheel">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <param name="i2c_index">1</param>
      </joint>
      <joint name="Rear_Right_Wheel">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <param name="i2c_index">0</param>
        <param name="velocity_sign">-1</param>
      </joint>
    </ros2_control>
  </xacro:macro>
</robot>
