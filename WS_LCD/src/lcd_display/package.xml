<?xml version="1.0"?>
<package format="3">
  <name>st7789_ros_wrapper</name>
  <version>0.1.0</version>
  <description>ROS 2 package for ST7789 LCD display on Raspberry Pi using spidev and libgpiod.</description>

  <maintainer email="todo@todo.com">ai-creare</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>ament_index_cpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <build_depend>libgpiod-dev</build_depend>
  <build_depend>libopencv-dev</build_depend>
  <exec_depend>libgpiod2</exec_depend>
  <exec_depend>libopencv-dev</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
