<?xml version="1.0"?>
<package format="3">
  <name>rocker_bogie_controller</name>
  <version>0.1.0</version>
  <description>Simple cmd_vel-to-wheel ros2_control controller for the rocker bogie robot.</description>
  <maintainer email="maintainer@example.com">Maintainer</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>controller_interface</depend>
  <depend>hardware_interface</depend>
  <depend>geometry_msgs</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>sensor_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <controller_interface plugin="${prefix}/rocker_bogie_controller_plugins.xml"/>
  </export>
</package>
