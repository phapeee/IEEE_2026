<?xml version="1.0"?>
<package format="3">
  <name>rocker_bogie_hardware</name>
  <version>0.1.0</version>
  <description>ros2_control SystemInterface bridging rocker bogie commands/state from Isaac Sim topics.</description>
  <maintainer email="maintainer@example.com">Maintainer</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>sensor_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <hardware_interface plugin="${prefix}/plugin_description.xml"/>
  </export>
</package>
